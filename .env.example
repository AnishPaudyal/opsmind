# Synthetic local-development examples only. Do not put real secrets here.
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

OPSMIND_PERSISTENCE_BACKEND=memory
OPSMIND_DATABASE_URL=postgresql+psycopg://opsmind:opsmind-development-only@127.0.0.1:5432/opsmind

# Protected business routes fail closed unless issuer, audience, and a PEM
# public verification key are configured together in the actual environment.
# Do not put a real key or bearer token in this tracked example file.
OPSMIND_AUTH_ALGORITHM=RS256
OPSMIND_AUTH_CLOCK_LEEWAY_SECONDS=0

# Docker Compose inputs for the PostgreSQL-only developer service.
OPSMIND_POSTGRES_DB=opsmind
OPSMIND_POSTGRES_USER=opsmind
OPSMIND_POSTGRES_PASSWORD=opsmind-development-only
OPSMIND_POSTGRES_PORT=5432

# Destructive integration fixtures reject URLs unless the database name ends
# in _test or _testing and the host is local or loopback.
OPSMIND_TEST_DATABASE_URL=postgresql+psycopg://opsmind:opsmind-development-only@127.0.0.1:55432/opsmind_test

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloud integration remains disabled.
AWS_REGION=us-east-1
