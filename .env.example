# Example values for a future local environment. Do not put real secrets here.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind
DATABASE_URL=postgresql+psycopg://opsmind:opsmind@localhost:5432/opsmind

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cloud integration is disabled during the repository-foundation phase.
AWS_REGION=us-east-1
